# ─────────────────────────────────────────────
# Landsec Capital — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Email (Gmail SMTP) ──────────────────────
# The Gmail address that sends all platform emails.
GMAIL_USER=landseccapital@gmail.com

# Gmail App Password (NOT your account password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2FA enabled on the Gmail account.
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Email address that receives admin OTP security codes.
SECURITY_EMAIL=your-security-email@example.com

# ── Session (API server only) ───────────────
# Random secret for signing session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# ── Database (optional — not required for current features) ─
# PostgreSQL connection string.
# Required only if you add server-side data persistence.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
